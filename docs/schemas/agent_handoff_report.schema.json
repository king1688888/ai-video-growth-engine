{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_handoff_report",
  "title": "AgentHandoffReport",
  "description": "模块交接报告结构（来源：D23/D24）",
  "type": "object",
  "required": ["module", "agent", "completed_at", "files", "start_command", "test_command", "rollback_plan"],
  "properties": {
    "module": { "type": "string", "description": "模块编号" },
    "module_name": { "type": "string" },
    "agent": { "type": "string", "description": "执行 Agent" },
    "completed_at": { "type": "string", "format": "date-time" },
    "pr_url": { "type": "string", "format": "uri" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "action": { "type": "string", "enum": ["created", "modified", "deleted"] },
          "description": { "type": "string" }
        },
        "required": ["path", "action"]
      }
    },
    "database_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": { "type": "string" },
          "action": { "type": "string", "enum": ["created", "modified"] },
          "migration_file": { "type": "string" }
        }
      }
    },
    "api_endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": { "type": "string" },
          "path": { "type": "string" },
          "description": { "type": "string" },
          "auth_required": { "type": "boolean" }
        }
      }
    },
    "environment_variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "required": { "type": "boolean" },
          "default": { "type": "string" }
        }
      }
    },
    "start_command": { "type": "string" },
    "test_command": { "type": "string" },
    "test_result": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "上游依赖模块"
    },
    "dependents": {
      "type": "array",
      "items": { "type": "string" },
      "description": "下游依赖模块"
    },
    "known_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rollback_plan": { "type": "string" },
    "unfinished_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "doc_writeback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc": { "type": "string" },
          "content": { "type": "string" },
          "status": { "type": "string", "enum": ["done", "pending"] }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
