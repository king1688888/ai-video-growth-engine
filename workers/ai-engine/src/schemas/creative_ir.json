{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative_ir",
  "title": "CreativeIR",
  "description": "Creative Intermediate Representation - 原创化中间层 (D09)",
  "type": "object",
  "required": ["creative_goal", "hook_strategy", "story_arc", "originality_constraints", "industry_adaptation"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "creative_goal": { "type": "string", "description": "创意目标" },
    "originality_level": { "type": "string", "enum": ["medium", "high", "very_high"], "default": "high" },
    "hook_strategy": {
      "type": "object",
      "required": ["type", "approach"],
      "properties": {
        "type": { "type": "string" },
        "approach": { "type": "string" },
        "user_adaptation": { "type": "string" }
      }
    },
    "story_arc": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "beats": { "type": "array", "items": { "type": "object" } },
        "user_story_seed": { "type": "string" }
      }
    },
    "originality_constraints": {
      "type": "object",
      "properties": {
        "must_not_copy": { "type": "array", "items": { "type": "string" } },
        "must_adapt": { "type": "array", "items": { "type": "string" } },
        "must_create_new": { "type": "array", "items": { "type": "string" } }
      }
    },
    "industry_adaptation": {
      "type": "object",
      "properties": {
        "industry": { "type": "string" },
        "persona": { "type": "string" },
        "product_service": { "type": "string" },
        "target_audience": { "type": "string" },
        "tone": { "type": "string" }
      }
    },
    "similarity_control": {
      "type": "object",
      "properties": {
        "max_structural_similarity": { "type": "number", "maximum": 0.7 },
        "max_textual_similarity": { "type": "number", "maximum": 0.3 }
      }
    }
  }
}
