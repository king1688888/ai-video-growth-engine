# ============================================================
# AI Video Growth Engine - Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local or real secrets to git
# ============================================================

# --- Application ---
NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=3001

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/ai_video_growth

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password
S3_BUCKET_UPLOADS=uploads-raw
S3_BUCKET_PROCESSING=processing
S3_BUCKET_PUBLISHED=assets-published
S3_BUCKET_INTERNAL=system-internal
S3_REGION=us-east-1

# --- AI Providers (DO NOT use real keys in dev) ---
OPENAI_API_KEY=sk-placeholder-do-not-use-real-key
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Auth ---
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Feature Flags ---
FEATURE_VIDEO_LINK_INPUT=false
FEATURE_VIDEO_GENERATION=false
FEATURE_AUTO_PUBLISH=false
FEATURE_MOCK_AI=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
