# ============================================================
# AI Video Growth Engine - Environment Variables
# Copy this file to .env.local for local dev.
# NEVER commit .env.local or real secrets to git.
# All <placeholder> values must be replaced via Secret Manager
# in staging/production. Do NOT hardcode real keys.
# ============================================================

# ---------- Application ----------
NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=3001

# ---------- Database ----------
# Format: mysql://user:pass@host:port/db (or postgresql)
DATABASE_URL=mysql://root:dev_password@localhost:3306/ai_video_growth

# ---------- Cache & Queue ----------
REDIS_URL=redis://localhost:6379

# ---------- Object Storage (S3-compatible) ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=<placeholder-access-key>
S3_SECRET_KEY=<placeholder-secret-key>
S3_BUCKET_UPLOADS=uploads-raw
S3_BUCKET_PROCESSING=processing
S3_BUCKET_PUBLISHED=assets-published
S3_BUCKET_INTERNAL=system-internal
S3_REGION=us-east-1

# ---------- AI Providers ----------
# Manus built-in LLM (auto-injected in Webdev, leave placeholder elsewhere)
BUILT_IN_FORGE_API_URL=<auto-injected-in-webdev>
BUILT_IN_FORGE_API_KEY=<auto-injected-in-webdev>

# OpenAI / compatible (set FEATURE_MOCK_AI=false to enable real calls)
OPENAI_API_KEY=sk-placeholder-do-not-use-real-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ASR / OCR (optional, MVP1.5+)
ASR_PROVIDER=mock
OCR_PROVIDER=mock
DASHSCOPE_API_KEY=<placeholder>

# ---------- Auth ----------
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Manus OAuth (auto-injected in Webdev)
VITE_APP_ID=<auto-injected>
OAUTH_SERVER_URL=<auto-injected>
VITE_OAUTH_PORTAL_URL=<auto-injected>

# ---------- Payment (MVP1.5+, default mock) ----------
FEATURE_MOCK_PAYMENT=true
WECHAT_PAY_MCHID=<placeholder>
WECHAT_PAY_APIV3_KEY=<placeholder>
WECHAT_PAY_WEBHOOK_SECRET=<placeholder>
ALIPAY_APP_ID=<placeholder>
ALIPAY_PRIVATE_KEY=<placeholder>
ALIPAY_PUBLIC_KEY=<placeholder>

# ---------- Monitoring & Alerting ----------
SENTRY_DSN=<placeholder>
SLACK_WEBHOOK_URL=<placeholder>
GRAFANA_API_KEY=<placeholder>

# ---------- Feature Flags ----------
FEATURE_MOCK_AI=true
FEATURE_VIDEO_LINK_INPUT=false
FEATURE_VIDEO_GENERATION=false
FEATURE_AUTO_PUBLISH=false
FEATURE_BATCH_ANALYSIS=false

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
VITE_APP_TITLE=AI 短视频爆款增长引擎
